# Copy to .env.local for local work. On Vercel, add these under Project Settings > Environment Variables.
# Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/sync and /api/agents/tick when called by Vercel Cron or Supabase pg_cron
CRON_SECRET=

# AI providers
OPENAI_API_KEY=
OPENAI_MANAGER_MODEL=gpt-4.1
OPENAI_WORKER_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Jev by TypeSafe AI. Leave empty until you have it; scoring falls back to OpenAI.
JEV_API_KEY=

# Shopify (custom app: Settings > Apps > Develop apps; scopes read_products, read_orders, read_inventory)
SHOPIFY_STORE_DOMAIN=parakkat-jewels.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Meta (Business Settings > System users; permissions ads_management, ads_read, pages_read_engagement, instagram_basic, instagram_manage_insights, business_management)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_IG_USER_ID=

# Google Ads (needs a developer token from the Google Ads API Center) and GA4
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GA4_PROPERTY_ID=
