# Copy to .env.local for local work. On Vercel, add these under Project Settings > Environment Variables.
# Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/sync and /api/agents/tick when called by Vercel Cron or Supabase pg_cron
CRON_SECRET=

# AI providers
# Default: user generates in native ChatGPT, then imports into Studio. No image API call.
ARTWORK_PROVIDER=chatgpt
# Optional isolated Codex worker: uses a separate ChatGPT login, not an image API key.
# Enable only after its Linux pilot succeeds; see deploy/chatgpt-image-worker/QUEUE.md.
CHATGPT_IMAGE_WORKER_ENABLED=false
# Dedicated internal supervisor credential; never forward it to the Codex child process.
CHATGPT_IMAGE_WORKER_SECRET=
# Legacy separately billed generation requires an explicit ARTWORK_PROVIDER=gemini opt-in.
# Self-hosted ChatGPT OAuth (Node.js 22+, persistent local storage; see docs/SELF_HOST.md).
# Set both CHATGPT_AUTH_ENABLED=true and LLM_PROVIDER=chatgpt to use your ChatGPT plan.
# Run npm run chatgpt -- login on your computer, then transfer credentials securely to the VPS.
CHATGPT_AUTH_ENABLED=false
# Absolute protected directory owned by the app's OS user. Default: ~/.config/parakkat-ai-office/chatgpt
CHATGPT_AUTH_DIR=
# Optional overrides. Leave blank to use the models chosen in Admin or the account's first available model.
CHATGPT_MANAGER_MODEL=
CHATGPT_WORKER_MODEL=
# Public HTTPS app origin on your VPS (also used by platform OAuth callbacks).
APP_URL=
# API-key mode remains optional when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MANAGER_MODEL=gpt-4.1
OPENAI_WORKER_MODEL=gpt-4.1-mini
# ChatGPT OAuth answers first; a verified NVIDIA NIM key can answer after its plan usage block.
LLM_PROVIDER=openai
NVIDIA_NIM_API_KEY=
# Hosted NIM model for text fallback. Keep within this model's output-token limit.
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional installed key. A key saved by the Super Admin takes priority, without exposing it to browsers.
GEMINI_API_KEY=
# Private directory for the Admin key override and image-check status. Compose sets
# /var/lib/parakkat-ai-office/provider-secrets; local default is ~/.config/parakkat-ai-office/provider-secrets.
GEMINI_CONFIG_DIR=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Optional: a stronger model for managers when Gemini answers, e.g. gemini-4-argon (defaults to GEMINI_TEXT_MODEL)
GEMINI_MANAGER_MODEL=
# Premium image generation with explicit resolution. 2K and 1K share Pro's image-output price.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=2K
# Jev by TypeSafe AI. Leave empty until you have it; scoring falls back to OpenAI.
JEV_API_KEY=

# Shopify (scopes read_products, read_orders, read_inventory). Dev Dashboard apps: client id and secret.
# Stores with an older custom app can set SHOPIFY_ADMIN_TOKEN instead.
SHOPIFY_STORE_DOMAIN=parakkat-jewels.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=

# Connecting from the Admin page (see docs/DEPLOY.md): the apps' own ids. Redirect URLs end in /api/connect/<meta|google|shopify>/callback.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Optional: the key that encrypts saved platform access (defaults to one derived from SUPABASE_SERVICE_ROLE_KEY)
CREDENTIALS_KEY=

# Or set Meta by hand (Business Settings > System users; permissions ads_management, ads_read, pages_read_engagement, instagram_basic, instagram_manage_insights, business_management)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_IG_USER_ID=

# Google Ads and GA4. API access now belongs to the Google Cloud project; the developer token is optional and ignored by Google.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GA4_PROPERTY_ID=

# SEO Desk. Keyword Planner uses the Google Ads keys above (Basic access needed for real volumes).
SEO_GEO_TARGETS=2356
SEO_LANGUAGE=1000
SEO_TRENDS_GEO=IN-KL
SEO_SEED_KEYWORDS=
# Optional: a SerpApi key gives a dependable Google Trends feed from servers
SERPAPI_KEY=

# Odoo (optional: connect it from Admin > Connections instead, where the key is stored encrypted)
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
# sales teams that count as the online store, comma separated
ODOO_ONLINE=
