# Copy to config.env on the editing Windows PC. Keep it private.
VIDEO_OFFICE_URL=https://ai-office.parakkatjewels.in
VIDEO_WORKER_TOKEN=replace-with-the-same-long-random-token-on-the-office-server
ANTHROPIC_API_KEY=your-own-claude-console-api-key
VIDEO_MEDIA_ROOT=%USERPROFILE%\Videos\AI Office\Input
VIDEO_EXPORT_ROOT=%USERPROFILE%\Videos\AI Office\Exports
# Optional adapter if your existing Claude–Resolve setup does more than cuts.
# VIDEO_BRIDGE_SCRIPT=C:\Path\To\bridge_adapter.py
