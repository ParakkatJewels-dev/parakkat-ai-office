# Copy to config.env on the editing Mac and chmod 600. Never commit that file.
VIDEO_OFFICE_URL=https://your-ai-office.example
VIDEO_WORKER_TOKEN=replace-with-the-same-long-random-token-on-the-office-server
# For unattended AI Office jobs, use an API key owned by this worker's operator.
ANTHROPIC_API_KEY=your-own-claude-console-api-key
VIDEO_MEDIA_ROOT='/Users/editor/Videos/AI Office/Input'
VIDEO_EXPORT_ROOT='/Users/editor/Videos/AI Office/Exports'
# Optional: path to your existing Python adapter if it accepts a manifest path.
# VIDEO_BRIDGE_SCRIPT=/Users/editor/resolve/bridge_adapter.py
# VIDEO_CLAUDE_BIN=/opt/homebrew/bin/claude
